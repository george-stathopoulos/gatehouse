{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Gatehouse demo",
		"author": "George Stathopoulos",
		"description": "A shop with three months of AI calls from several plugins, with budgets, hourly limits and a personal data report."
	},
	"landingPage": "/wp-admin/admin.php?page=gatehouse",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"features": {
		"networking": true
	},
	"login": true,
	"steps": [
		{
			"step": "setSiteOptions",
			"options": {
				"blogname": "Northwind Coffee Roasters"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "ai-provider-for-anthropic"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "defineWpConfigConsts",
			"consts": {
				"ANTHROPIC_API_KEY": "sk-ant-demo-placeholder"
			}
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/mu-plugins/gatehouse-demo.php",
			"data": {
				"resource": "url",
				"url": "https://george-stathopoulos.github.io/gatehouse/demo/gatehouse-demo.php.txt"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://george-stathopoulos.github.io/gatehouse/demo/gatehouse.zip"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "wp-cli",
			"command": "wp gatehouse seed --days=95"
		},
		{
			"step": "wp-cli",
			"command": "wp eval \"Gatehouse_Onboarding::complete(); delete_transient( Gatehouse_Onboarding::REDIRECT );\""
		}
	]
}
